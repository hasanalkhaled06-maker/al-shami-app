{
  "id": "./admin.html",
  "name": "AL SHAMI Admin",
  "short_name": "SHAMI ADMIN",
  "description": "Private management dashboard for AL SHAMI RESTAURANT & FAST FOOD.",
  "start_url": "./admin.html",
  "scope": "./",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "orientation": "portrait",
  "background_color": "#F6F1E7",
  "theme_color": "#EAF2F7",
