+  $("#login-form").onsubmit=async e=>{e.preventDefault();const f=new FormData(e.currentTarget);const {error}=await db.auth.signInWithPassword({email:f.get('email'),password:f.get('password')});$("#login-message").textContent=error?.message||'';if(!error)await enter();};
